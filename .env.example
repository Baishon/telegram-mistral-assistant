# Telegram API credentials for your personal account:
# Create them at https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Mistral API key and the Agent ID from the Mistral Agents page:
MISTRAL_API_KEY=
MISTRAL_AGENT_ID=
# Optional version number; 0 uses the default version shown in the example.
MISTRAL_AGENT_VERSION=0

# Optional Bot API token from @BotFather.
# The personal-account /bot command does not use this token.
BOT_TOKEN=

# Telethon session file; keep it private and do not share it.
TELEGRAM_SESSION=data/user_session
